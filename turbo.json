{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "PAYHERE_MERCHANT_ID",
    "PAYHERE_SANDBOX",
    "PUBLIC_BASE_URL",
    "AUTO_VERIFY_DELIVERY",
    "REQUIRE_MFA",
    "DUAL_CONTROL_THRESHOLD_CENTS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "PAYHERE_MERCHANT_SECRET",
        "COURIER_WEBHOOK_SECRET",
        "CRON_SECRET"
      ]
    },
    "lint": {},
    "typecheck": {},
    "format": { "cache": false },
    "test": { "cache": false, "env": ["DATABASE_URL_TEST"] },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "passThroughEnv": ["DATABASE_URL_DIRECT"] },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PAYHERE_MERCHANT_SECRET",
        "COURIER_WEBHOOK_SECRET",
        "CRON_SECRET"
      ]
    }
  }
}
